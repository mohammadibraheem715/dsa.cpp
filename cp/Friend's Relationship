#include<bits/stdc++.h>
using namespace std;
int main(){
	int a,t;
	cin>>t;
	while(t--){
		cin>>a;
		for(int i=0;i<a;i++) {
			for(int j=0;j<=i;j++)
			{cout<<"*";}
            
            for(int j=a;j-1>i;j--)
		    {cout<<"##";}
         
			for(int j=0;j<=i;j++)
			{ cout<<"*";}
            cout<<endl;
        }
    }
	
	}